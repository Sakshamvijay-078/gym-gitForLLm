# ── Client Node Image (GPU required) ──────────────────────────────────────────
FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev curl git && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf python3 /usr/bin/python && ln -sf pip3 /usr/bin/pip

COPY requirements-gpu.txt .
RUN pip install --no-cache-dir -r requirements-gpu.txt

COPY client_node.py .

# Register with orchestrator, then start Flower client
CMD ["sh", "-c", "\
    curl -sf -X POST http://orchestrator:8000/register \
         -H 'Content-Type: application/json' \
         -d \"{\\\"node_id\\\": \\\"$NODE_ID\\\", \\\"ram_gb\\\": 16, \\\"compute_score\\\": $COMPUTE_SCORE}\" || true && \
    TASK=$(curl -sf http://orchestrator:8000/assign_task/$NODE_ID) && \
    DATASET=$(echo $TASK | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"dataset_dir\",\"\"))') && \
    EXPERTS=$(echo $TASK | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\" \".join(map(str,d.get(\"expert_indices\",[0,1]))))') && \
    python client_node.py \
        --server_address $SERVER_ADDRESS \
        --model_name $MODEL_NAME \
        --expert_indices $EXPERTS \
        --dataset_dir $DATASET \
        --checkpoint_dir /checkpoints/$NODE_ID \
        --compute_score $COMPUTE_SCORE \
        --local_steps $LOCAL_STEPS \
        --checkpoint_every $CHECKPOINT_EVERY \
        --batch_size $BATCH_SIZE \
        --lr $LR \
        --node_id $NODE_ID \
        --heartbeat_url $HEARTBEAT_URL \
"]
