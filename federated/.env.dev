# ─────────────────────────────────────────────────────────────────
# DEV MODE — for U-series CPU + 8 GB RAM (no GPU required)
# Usage: docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up
# ─────────────────────────────────────────────────────────────────

# ToyMoE local model — created by: python dev/toy_moe.py --save_path ./toy_moe_model
MODEL_NAME=./toy_moe_model

# Small public dataset, no auth needed
DATASET_NAME=wikitext
DATASET_CONFIG=wikitext-2-raw-v1

# Pipeline: tiny run
TOP_K=2
PURITY_THRESHOLD=0.0
MAX_CHUNKS=200
BATCH_SIZE=4
NO_4BIT=true

# Federation: minimal rounds
FL_ROUNDS=3
FL_MIN_CLIENTS=1

# Client: minimal compute
NODE_ID=node_dev
EXPERT_INDICES=0 1
COMPUTE_SCORE=0.3
LOCAL_STEPS=20
CHECKPOINT_EVERY=5
LR=2e-4

# Infrastructure
REDIS_HOST=redis
REDIS_PORT=6379
FLOWER_PORT=8080
API_PORT=8000
WATCHDOG_INTERVAL_S=15
