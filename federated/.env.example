# ─────────────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in values
# ─────────────────────────────────────────────────────────

# HuggingFace
HF_TOKEN=hf_your_token_here
MODEL_NAME=mistralai/Mixtral-8x7B-Instruct-v0.1

# Dataset for data pipeline
DATASET_NAME=HuggingFaceH4/ultrachat_200k

# Data pipeline settings
TOP_K=2
PURITY_THRESHOLD=0.0
MAX_CHUNKS=50000
BATCH_SIZE=32

# Flower federation
FL_ROUNDS=10
FL_MIN_CLIENTS=2

# Client node settings (override per instance)
NODE_ID=node_0
EXPERT_INDICES=0 1
COMPUTE_SCORE=0.5
LOCAL_STEPS=200
CHECKPOINT_EVERY=50
LR=2e-4

# Infrastructure
REDIS_HOST=redis
REDIS_PORT=6379
FLOWER_PORT=8080
API_PORT=8000
WATCHDOG_INTERVAL_S=15
